{
  "name": "@jcfigueiredo/evem",
  "version": "0.3.1",
  "description": "Lightweight TypeScript event emitter with wildcards, priorities, middleware, filters, throttle/debounce, schema validation, event history, and optional WebSocket and Server-Sent Events adapters",
  "keywords": [
    "event-emitter",
    "events",
    "pubsub",
    "wildcard",
    "middleware",
    "websocket",
    "server-sent-events",
    "sse",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcfigueiredo/evem.git"
  },
  "homepage": "https://github.com/jcfigueiredo/evem#readme",
  "bugs": {
    "url": "https://github.com/jcfigueiredo/evem/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "default": "./dist/websocket/index.js"
    },
    "./sse": {
      "types": "./dist/sse/index.d.ts",
      "default": "./dist/sse/index.js"
    },
    "./sse/server": {
      "types": "./dist/sse/server.d.ts",
      "default": "./dist/sse/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest",
    "test:nowatch": "vitest --watch=false",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "format": "prettier --write src tests scripts vitest.config.ts demo/src demo/vite.config.ts demo/index.html demo/playground",
    "format:check": "prettier --check src tests scripts vitest.config.ts demo/src demo/vite.config.ts demo/index.html demo/playground",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm test:nowatch && pnpm test:package",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^18.17.0",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "^1.0.4",
    "daisyui": "^5.7.47",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.1.6",
    "vite": "^8.3.2",
    "vitest": "^1.0.4"
  },
  "packageManager": "pnpm@9.15.9"
}
