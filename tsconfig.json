{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": true,

    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ES2022"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "incremental": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@jcfigueiredo/evem": ["./src/index.ts"],
      "@jcfigueiredo/evem/websocket": ["./src/websocket/index.ts"],
      "@jcfigueiredo/evem/sse": ["./src/sse/index.ts"],
      "@jcfigueiredo/evem/sse/server": ["./src/sse/server.ts"],
      "@jcfigueiredo/evem/dom": ["./src/dom/index.ts"],
      "@jcfigueiredo/evem/alpine": ["./src/alpine/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "tests/docs/preludes"]
}
